# ─────────────────────────────────────────────────────────────
# Base de datos (Neon)
# ─────────────────────────────────────────────────────────────
# Connection string POOLED de Neon (con pgbouncer). La usa la app en runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"
# Connection string DIRECTA de Neon (sin pgbouncer). La usan las migraciones de Prisma.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Cloudinary (subida firmada)
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─────────────────────────────────────────────────────────────
# Auth.js (NextAuth)
# ─────────────────────────────────────────────────────────────
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Rate limiting (Upstash Redis) — OPCIONAL
# ─────────────────────────────────────────────────────────────
# Si no se configuran, se usa un limitador en memoria (solo válido para
# una única instancia / desarrollo). En producción con varias instancias
# conviene configurar Upstash.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

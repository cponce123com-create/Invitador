// Schema de Prisma para la plataforma de invitaciones.
//
// Notas de diseño:
// - `datasource.directUrl` apunta a la connection string DIRECTA de Neon: Prisma
//   la usa para las migraciones (pgbouncer no soporta las sentencias DDL).
//   `url` es la connection string pooled que usa la app en runtime.
// - La autenticación es con email + contraseña. `passwordHash` es opcional para
//   no romper filas creadas antes de habilitar el login por credenciales: una
//   fila sin hash simplemente no puede iniciar sesión.
// - `isSuperAdmin` marca la cuenta que crea y gestiona al resto de usuarios.
//   El primer super admin se crea desde `/setup`.
// - Los fondos (`BackgroundTemplate`) NO son fotos: se generan en código como
//   gradientes CSS o patrones SVG (ver `lib/backgrounds.ts`). Se guardan en la
//   base para poder agregar/quitar plantillas sin tocar código.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Host {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  events       Event[]
}

enum EventType {
  CUMPLEANOS
  BABY_SHOWER
  BODA
  BAUTIZO
  GRADUACION
  OTRO
}

/// Tipo de fondo demo: un degradado CSS o un patrón SVG repetido.
enum BackgroundKind {
  GRADIENT
  PATTERN
}

/// Fondo/plantilla visual reutilizable que el anfitrión elige para la portada.
/// Es independiente de la foto de portada del evento: si hay foto, la foto gana;
/// si no, se usa este fondo.
model BackgroundTemplate {
  id          String         @id @default(cuid())
  name        String
  eventType   EventType? // null = sirve para cualquier tipo de evento
  kind        BackgroundKind
  // GRADIENT: colores hex del degradado (2 o más).
  // PATTERN: [color base del lienzo, color del trazo del patrón].
  colors      String[]
  // PATTERN: nombre del patrón SVG a renderizar (ver `lib/backgrounds.ts`).
  patternName String?
  // Escalable: hoy todo es gratis, pero el dato queda modelado para planes de
  // pago sin tener que migrar el schema (mismo criterio que maxGuestsPerRsvp).
  isPremium   Boolean        @default(false)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  events      Event[]

  @@index([eventType, order])
}

model Event {
  id                   String              @id @default(cuid())
  hostId               String
  host                 Host                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  slug                 String              @unique // usado en la URL pública: /e/[slug]
  title                String
  type                 EventType
  customLabel          String? // ej: "Baby Shower de Sofía" o para tipo OTRO
  ageOrDetail          String? // ej: "Cumple 5 años" — texto libre para flexibilidad
  eventDate            DateTime?
  /// Cierre de la lista de invitados (opcional). Se guarda como "hora de pared"
  /// (misma convención que `eventDate`): la cuenta regresiva de la invitación y
  /// el rechazo de confirmaciones tardías lo interpretan en la zona horaria de la
  /// plataforma (`EVENT_TIME_ZONE`). Sin fecha, la lista no se cierra sola.
  rsvpDeadline         DateTime?
  location             String?
  /// Foto del lugar de la celebración (opcional). Es independiente de la
  /// galería: no consume el cupo de fotos ni se borra al editar las fotos.
  locationImageUrl     String?
  /// Link de Google Maps que pega el anfitrión para que los invitados abran la
  /// ubicación. Sin link, la invitación no muestra el botón de mapa.
  mapUrl               String?
  description          String?             @db.Text
  coverImageUrl        String?
  /// Imagen del código QR de la mesa de regalos (opcional). En la invitación se
  /// muestra ampliable, debajo del formulario de confirmación.
  giftQrUrl            String?
  /// Texto que acompaña al QR: llave, número de cuenta, etc.
  giftMessage          String?             @db.Text
  /// Foto que indica el código de vestimenta que se espera en el evento
  /// (opcional). Igual que la foto del lugar, es una casilla aparte: no gasta
  /// el cupo de la galería ni se borra al editar las fotos.
  dressCodeImageUrl    String?
  backgroundTemplateId String?
  backgroundTemplate   BackgroundTemplate? @relation(fields: [backgroundTemplateId], references: [id], onDelete: SetNull)
  isActive             Boolean             @default(true)
  maxGuestsPerRsvp     Int                 @default(3) // escalable: configurable por evento
  createdAt            DateTime            @default(now())
  photos               EventPhoto[]
  rsvps                Rsvp[]
  giftProofs           GiftProof[]

  @@index([hostId])
  @@index([backgroundTemplateId])
}

model EventPhoto {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cloudinaryId String
  url          String
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([eventId])
}

/// Comprobante de regalo que sube un invitado desde la invitación pública.
/// No requiere sesión: el endpoint que lo crea limita por IP y el anfitrión
/// puede borrar los que sobren desde su panel.
model GiftProof {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderName   String
  note         String?
  cloudinaryId String
  url          String
  createdAt    DateTime @default(now())

  @@index([eventId])
}

enum AttendanceStatus {
  SI
  NO
  TAL_VEZ
}

model Rsvp {
  id               String            @id @default(cuid())
  eventId          String
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mainGuestName    String
  mainGuestPhone   String?
  attendance       AttendanceStatus
  message          String?           @db.Text
  createdAt        DateTime          @default(now())
  additionalGuests AdditionalGuest[]

  @@index([eventId])
}

enum GuestRelation {
  FAMILIAR
  AMIGO
  AMIGA
  NOVIO
  NOVIA
  ESPOSO
  ESPOSA
  COMPANERO_TRABAJO
  OTRO
}

model AdditionalGuest {
  id        String        @id @default(cuid())
  rsvpId    String
  rsvp      Rsvp          @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  name      String
  relation  GuestRelation
  createdAt DateTime      @default(now())

  @@index([rsvpId])
}
